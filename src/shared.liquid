<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script type="text/javascript">
  // No animation anywhere
  Highcharts.setOptions({ chart: { animation: false }, plotOptions: { series: { animation: false } } });
</script>
{%- comment -%}
  Shared data prep — trmnlp automatically prepends this file (src/shared.liquid)
  to every view, so the variables and {% template %} partials below are
  available in all layouts.

  Source: two Umami GET requests, exposed by TRMNL as index-based nodes:
    IDX_0  /websites/:id/stats     -> { pageviews, visitors, visits, bounces,
                                        totaltime, comparison: {...prev totals} }
    IDX_1  /websites/:id/pageviews -> { pageviews: [{x,y}...], sessions: [...] }

  `visitors/pageviews/visits/bounces` are the period totals shown in the tiles.
  `comparison` holds the previous period's totals, from which we derive each
  tile's % change (percentage-point change for bounce rate). IDX_1's two daily
  series drive the chart; Umami has no daily `visits` series.

  A genuine 0 stays 0; a missing metric stays nil (views render "—"). trmnlp's
  poller discards non-200 response bodies (returns {} and logs the error to the
  server console), so on an HTTP error IDX_0 is empty and views fall through to
  the "no data" notice.
{%- endcomment -%}
{%- assign api_error = IDX_0.error -%}
{%- assign has_data = false -%}
{%- if IDX_0.visitors != blank or IDX_0.pageviews != blank -%}{%- assign has_data = true -%}{%- endif -%}

{%- comment -%} Notice copy, shared by all four layouts. {%- endcomment -%}
{%- assign no_data_title = 'Not connected' -%}
{%- assign no_data_body = 'Umami returned no data. Check the API key, Website ID and hosting type in this plugin&rsquo;s settings.' -%}
{%- assign error_title = 'Umami error' -%}

{%- assign visitors = IDX_0.visitors -%}
{%- assign pageviews = IDX_0.pageviews -%}
{%- assign visits = IDX_0.visits -%}
{%- assign bounces = IDX_0.bounces -%}

{%- comment -%} Bounce rate as a whole-number percent: bounced sessions / visits. {%- endcomment -%}
{%- assign bounce_rate = null -%}
{%- if visits != blank and visits > 0 -%}
  {%- assign bounce_rate = bounces | times: 100.0 | divided_by: visits | round -%}
{%- endif -%}

{%- comment -%}
  Daily [{x,y}] series for the chart. Umami's `sessions` counts distinct
  visitors per day, so it is the daily counterpart of the `visitors` total.
{%- endcomment -%}
{%- assign pv_points = IDX_1.pageviews -%}
{%- assign visitor_points = IDX_1.sessions -%}

{%- comment -%}
  Chart options. `chart_lines` picks the series; `chart_axes` only matters when
  both are drawn, since one series always fits one axis.
{%- endcomment -%}
{%- assign chart_lines = trmnl.plugin_settings.custom_fields_values.chart_lines | default: 'both' -%}
{%- assign show_visitors = false -%}
{%- assign show_pageviews = false -%}
{%- if chart_lines != 'pageviews' -%}{%- assign show_visitors = true -%}{%- endif -%}
{%- if chart_lines != 'visitors' -%}{%- assign show_pageviews = true -%}{%- endif -%}
{%- assign dual_axes = false -%}
{%- if chart_lines == 'both' and trmnl.plugin_settings.custom_fields_values.chart_axes == 'dual' -%}
  {%- assign dual_axes = true -%}
{%- endif -%}

{%- comment -%}
  Deltas vs. the previous period, from IDX_0.comparison. Counts get a % change;
  bounce rate gets a percentage-point change (its own delta is already a %).
  Each stays nil when the comparison is absent or its base is 0, so the tile
  renders "—" rather than a bogus arrow.
{%- endcomment -%}
{%- assign cmp = IDX_0.comparison -%}
{%- assign visitors_delta = null -%}
{%- assign pageviews_delta = null -%}
{%- assign visits_delta = null -%}
{%- assign bounce_delta = null -%}
{%- if cmp != blank -%}
  {%- if cmp.visitors != blank and cmp.visitors > 0 -%}
    {%- assign visitors_delta = visitors | minus: cmp.visitors | times: 100.0 | divided_by: cmp.visitors | round -%}
  {%- endif -%}
  {%- if cmp.pageviews != blank and cmp.pageviews > 0 -%}
    {%- assign pageviews_delta = pageviews | minus: cmp.pageviews | times: 100.0 | divided_by: cmp.pageviews | round -%}
  {%- endif -%}
  {%- if cmp.visits != blank and cmp.visits > 0 -%}
    {%- assign visits_delta = visits | minus: cmp.visits | times: 100.0 | divided_by: cmp.visits | round -%}
  {%- endif -%}
  {%- if cmp.visits != blank and cmp.visits > 0 and bounce_rate != blank -%}
    {%- assign prev_bounce_rate = cmp.bounces | times: 100.0 | divided_by: cmp.visits | round -%}
    {%- assign bounce_delta = bounce_rate | minus: prev_bounce_rate -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  um_metric — one metric tile: big number + a "change vs. previous period" line.
  Params: value (number|nil), label, delta (signed number|nil), suffix ("%" or
  "pt" for the delta unit), value_suffix (appended to the number, e.g. "%"),
  value_class (size classes), delta_class (extra classes on the delta line,
  e.g. to hide it on cramped screens). Isolated scope, so all data is passed in.
{%- endcomment -%}
{% template um_metric %}
<div class="item bg--white dark:bg--gray-60 rounded--medium">
  <div class="content w--full">
    <div class="px--4 pt--4 w--full">
      <span class="value value--tnums {{ value_class }}" data-fit-value="true">
        {%- if value == blank -%}
          —
        {%- else -%}
          {{- value -}}
          {{- value_suffix -}}
        {%- endif -%}
      </span>
    </div>
    <span class="label px--4">{{ label }}</span>
    <span class="label px--4 pb--4 {{ delta_class }}">
      {%- if delta == blank -%}
        —
      {%- elsif delta > 0 -%}
        ▲ {{ delta -}}
        {{- suffix }}
      {%- elsif delta < 0 -%}
        ▼ {{ delta | times: -1 -}}
        {{- suffix }}
      {%- else -%}
        ± 0{{ suffix }}
      {%- endif -%}
    </span>
  </div>
</div>
{% endtemplate %}

{%- comment -%}
  um_chart — daily splines with dated x ticks: Visitors solid, Pageviews dotted.
  Params: pv_points / visitor_points ([{x,y}] arrays), show_visitors /
  show_pageviews (booleans, from the Chart Lines field), dual_axes (boolean,
  from Chart Y Axis — pageviews outnumber visitors by roughly an order of
  magnitude, so a shared axis flattens the visitors line while two axes give
  each series its own scale). The chart fills its card, so each layout sizes it
  on the wrapping .grid.
{%- endcomment -%}
{% template um_chart %}
{% assign chart_id = 'um-chart-' | append_random %}
<div class="item bg--white dark:bg--gray-60 rounded--medium py--4 px--1">
  <div class="w--full h--full" id="{{ chart_id }}"></div>
</div>
<script type="text/javascript">
  (function () {
    var labels = { style: { fontSize: "16px", color: "#000000" } };
    {%- comment -%} Umami omits days with no traffic; restore them as 0 so the line doesn't interpolate across them. {%- endcomment -%}
    var fillGaps = function (points) {
      if (!points.length) { return points; }
      var day = 86400000, last = points[points.length - 1][0], out = [], i = 0;
      for (var t = points[0][0]; t <= last; t += day) {
        out.push([t, points[i] && points[i][0] === t ? points[i++][1] : 0]);
      }
      return out;
    };
    var dual = {% if dual_axes %}true{% else %}false{% endif %};
    var series = [];
    {%- if show_visitors -%}
    series.push({ name: "Visitors", dashStyle: "Solid", data: fillGaps([{% for p in visitor_points %}[{{ p.x | date: '%s' | append: '000' }}, {{ p.y }}]{% unless forloop.last %}, {% endunless %}{% endfor %}]) });
    {%- endif -%}
    {%- if show_pageviews -%}
    series.push({ name: "Pageviews", dashStyle: "ShortDot", yAxis: dual ? 1 : 0, data: fillGaps([{% for p in pv_points %}[{{ p.x | date: '%s' | append: '000' }}, {{ p.y }}]{% unless forloop.last %}, {% endunless %}{% endfor %}]) });
    {%- endif -%}
    var yAxis = { title: { text: null }, min: 0, tickAmount: 4, labels: labels, gridLineWidth: 1, gridLineColor: "#000000", gridLineDashStyle: "ShortDot" };
    {%- comment -%}
      Dual axes name their series in a title sitting above each axis — left for
      Visitors, right for Pageviews — so the legend would only repeat them. The
      dash prefix stands in for the legend's line symbol. Both axes keep
      tickAmount: 4 so their gridlines line up; only the left one draws them.
    {%- endcomment -%}
    var axisTitle = function (text, side) {
      return { text: text, align: "high", textAlign: side, rotation: 0, offset: 0, y: -12, reserveSpace: false, style: { fontSize: "16px", color: "#000000" } };
    };
    var draw = function () {
      Highcharts.chart("{{ chart_id }}", {
        {%- comment -%} Dual axes need top spacing for their titles; single-axis charts get it from the legend. {%- endcomment -%}
        chart: { type: "spline", height: null, spacing: [dual ? 32 : 2, 4, 0, 0], backgroundColor: "transparent" },
        title: { text: null }, credits: { enabled: false }, tooltip: { enabled: false },
        legend: { enabled: !dual, align: "right", verticalAlign: "top", margin: 4, padding: 0, symbolWidth: 28, itemStyle: { fontSize: "16px", fontWeight: "400", color: "#000000" } },
        xAxis: {
          type: "datetime", labels: labels, tickPixelInterval: 110,
          lineWidth: 1, lineColor: "#000000", tickWidth: 0,
          gridLineWidth: 1, gridLineColor: "#000000", gridLineDashStyle: "Dot"
        },
        yAxis: dual ? [
          Highcharts.merge(yAxis, { title: axisTitle("— Visitors", "left") }),
          Highcharts.merge(yAxis, { gridLineWidth: 0, opposite: true, title: axisTitle("⋯ Pageviews", "right") })
        ] : yAxis,
        plotOptions: { spline: { color: "#000000", lineWidth: 3, marker: { enabled: false }, enableMouseTracking: false } },
        series: series
      });
    };
    if (document.readyState !== "loading") { draw(); } else { document.addEventListener("DOMContentLoaded", draw); }
  })();
</script>
{% endtemplate %}

{%- comment -%}
  um_notice — full-width message tile for the error / no-data states.
  Params: title (string), body (string).
{%- endcomment -%}
{% template um_notice %}
<div class="grid">
  <div class="item bg--white dark:bg--gray-60 rounded--medium p--4">
    <div class="content">
      <span class="value value--large lg:value--xlarge">{{ title }}</span>
      <span class="label">{{ body }}</span>
    </div>
  </div>
</div>
{% endtemplate %}

{%- comment -%}
  um_title_bar — shared footer. Params: trmnl (namespace,
  must be passed since render scope is isolated).
{%- endcomment -%}
{% template um_title_bar %}
<div class="title_bar bg--white dark:bg--gray-60">
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 428 389.11">
    <g><g><circle cx="214.15" cy="181" r="171" fill="#fff" stroke="#000" stroke-miterlimit="10" stroke-width="20"></circle><path d="M413 134.11H15.29a15 15 0 0 0-15 15v15.3C.12 168 0 171.52 0 175.11c0 118.19 95.81 214 214 214 116.4 0 211.1-92.94 213.93-208.67 0-.44.07-.88.07-1.33v-30a15 15 0 0 0-15-15"></path></g></g>
  </svg>
  <span class="title">{{ trmnl.plugin_settings.custom_fields_values.project_name | truncate: 32 }}</span>
  <span class="instance">Past {{ trmnl.plugin_settings.custom_fields_values.date_from | default: 30 }} days</span>
</div>
{% endtemplate %}
