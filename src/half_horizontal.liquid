{%- comment -%} Layout only — data prep + um_* partials live in src/shared.liquid. {%- endcomment -%}
<div class="layout layout--col gap--space-between bg--gray-70 p--4">
  {%- if api_error != blank -%}
    {% render "um_notice" with title: error_title, body: api_error %}
  {%- elsif has_data -%}
    <div class="grid grid--cols-4 portrait:grid--cols-2 gap--small">
      {% render "um_metric" with value: visitors, label: "Visitors", delta: visitors_delta, suffix: "%", value_class: "value--large lg:value--xlarge lg:portrait:value--xxlarge" %}
      {% render "um_metric" with value: pageviews, label: "Pageviews", delta: pageviews_delta, suffix: "%", value_class: "value--large lg:value--xlarge lg:portrait:value--xxlarge" %}
      {% render "um_metric" with value: visits, label: "Visits", delta: visits_delta, suffix: "%", value_class: "value--large lg:value--xlarge lg:portrait:value--xxlarge" %}
      {% render "um_metric" with value: bounce_rate, label: "Bounce Rate", delta: bounce_delta, suffix: "pt", value_suffix: "%", value_class: "value--large lg:value--xlarge lg:portrait:value--xxlarge" %}
    </div>
  {%- else -%}
    {% render "um_notice" with title: no_data_title, body: no_data_body %}
  {%- endif -%}
</div>

{% render "um_title_bar" with trmnl: trmnl %}
