# Copy this file to `.env` and fill in your Umami credentials.
# `.env` is gitignored; .trmnlp.yml reads these via {{ env.* }} and
# bin/trmnlp loads them automatically into the dev server.

# Base URL of your self-hosted Umami instance (no trailing slash).
# The plugin appends /api/websites/… itself.
UMAMI_URL=https://analytics.example.com

# Bearer token for the Umami API. Obtain one by POSTing your
# username/password to POST {UMAMI_URL}/api/auth/login.
# https://umami.is/docs/api/authentication
UMAMI_TOKEN=your_umami_api_token

# The website's UUID (Umami → Settings → Websites → Edit → Website ID).
UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000